[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "csdm"]
	path = csdm
	url = https://github.com/macosso/csdm
[submodule "numops"]
	path = numops
	url = https://github.com/macosso/numops
[submodule "xtsum"]
	path = xtsum
	url = https://github.com/macosso/xtsum
